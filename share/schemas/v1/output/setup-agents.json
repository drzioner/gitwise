{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitwise.dev/schemas/v1/output/setup-agents.json",
  "title": "gitwise setup-agents cli output",
  "description": "v3 envelope for `gitwise setup-agents --json`. Standardised in 0.36: the command used to emit its fields at the top level with a v_compat list of its own; it now uses the same nested-data envelope as every other command, and `errors` carries {code, message} objects rather than bare strings.",
  "type": "object",
  "required": [
    "v",
    "ok",
    "command",
    "data",
    "hints",
    "errors"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 3
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "const": "setup-agents"
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "dry_run",
        "root",
        "mode",
        "canonical_layout",
        "actions",
        "warnings",
        "summary"
      ],
      "properties": {
        "dry_run": {
          "type": "boolean"
        },
        "root": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "global",
            "local"
          ]
        },
        "canonical_layout": {
          "type": "string",
          "enum": [
            "agents_dir",
            "agents_md",
            "claude_only",
            "unknown"
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "action"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "action": {
                "type": "string"
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "object",
          "required": [
            "created",
            "appended",
            "symlinked",
            "skipped",
            "errored"
          ],
          "properties": {
            "created": {
              "type": "integer"
            },
            "appended": {
              "type": "integer"
            },
            "symlinked": {
              "type": "integer"
            },
            "skipped": {
              "type": "integer"
            },
            "errored": {
              "type": "integer"
            }
          }
        },
        "bucket": {
          "type": "integer",
          "description": "5-bucket layout id (local mode only)"
        },
        "agents_md_detected": {
          "type": "boolean",
          "description": "local mode only"
        },
        "agents_dir_detected": {
          "type": "boolean",
          "description": "local mode only"
        },
        "supports_symlinks": {
          "type": "boolean",
          "description": "local mode only"
        }
      }
    }
  }
}
