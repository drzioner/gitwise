{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitwise.dev/schemas/v1/input/guard.json",
  "title": "gitwise guard cli input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "lang": {
      "type": "string",
      "enum": [
        "es",
        "en"
      ],
      "description": "output language (default: auto-detect from locale)"
    },
    "theme": {
      "type": "string",
      "enum": [
        "dark",
        "light",
        "auto"
      ],
      "description": "color theme: dark, light, or auto-detect (default: auto)"
    },
    "json": {
      "type": "boolean",
      "description": "output JSON",
      "default": false
    },
    "json_pretty": {
      "type": "boolean",
      "description": "pretty-print JSON output",
      "default": false
    },
    "action": {
      "type": "string",
      "enum": [
        "check",
        "install"
      ]
    },
    "push": {
      "type": "boolean",
      "description": "evaluate a push, reading pre-push ref updates from stdin",
      "default": false
    },
    "commit_msg": {
      "type": "string",
      "description": "evaluate the commit message in PATH against the policy"
    },
    "hooks_mode": {
      "type": "string",
      "enum": [
        "preserve",
        "native",
        "legacy",
        "skip"
      ],
      "description": "hooks strategy for install: preserve (default), native, legacy, or skip",
      "default": "preserve"
    },
    "uninstall": {
      "type": "boolean",
      "description": "remove the policy hooks instead of installing them (install only)",
      "default": false
    },
    "dry_run": {
      "type": "boolean",
      "description": "show actions without executing",
      "default": false
    },
    "yes": {
      "type": "boolean",
      "description": "skip confirmation",
      "default": false
    }
  }
}
